# Copiá este archivo como .env y completá los valores.
# El .env NO se sube al repositorio (está en .gitignore).

# --- Base de datos ---
# Vacío = SQLite local en ./turnos.db (no hace falta instalar nada).
# En Render se usa SQLite sobre el disco persistente montado en /var/data:
#   DATABASE_URL=sqlite:////var/data/turnos.db      (cuatro barras: esquema + ruta absoluta)
# Si algún día migrás a Postgres, alcanza con cambiar esta línea:
#   DATABASE_URL=postgresql://usuario:password@host:5432/turnos

# --- Sesiones ---
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# --- Google OAuth ---
# Se sacan de https://console.cloud.google.com/apis/credentials
# En "Orígenes autorizados de JavaScript":  http://localhost:8000
# En "URI de redireccionamiento autorizados": http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Login de desarrollo ---
# true = permite entrar con cualquier email sin Google (SOLO local).
# La app se niega a arrancar si esto queda en true con ENVIRONMENT=production.
DEV_LOGIN=true
ENVIRONMENT=development

# --- Administradores ---
# Emails que ven el panel /admin, separados por comas.
ADMIN_EMAILS=tu-email@gmail.com

# --- Empresa ---
COMPANY_NAME=Aeroplantas YPF
COMPANY_TAGLINE=Turnos de abastecimiento de combustible aeronáutico
SUPPORT_EMAIL=turnos@tudominio.com

# --- Emails (Resend) ---
# Sin RESEND_API_KEY los emails NO se envían: se guardan como .html en outbox/
# para que puedas revisarlos. En producción la app exige la clave (o EMAIL_ENABLED=false).
# La clave se saca de https://resend.com/api-keys
RESEND_API_KEY=
# El dominio del remitente tiene que estar verificado en Resend.
# Para probar sirve el sandbox: Turnos <onboarding@resend.dev>
EMAIL_FROM=Turnos Aeroplantas <turnos@tudominio.com>
EMAIL_ENABLED=true
# Horas de anticipación del email recordatorio.
REMINDER_HOURS_BEFORE=24
# La app barre y manda los recordatorios sola, cada hora. Apagalo solo si vas a
# dispararlos desde afuera con send_reminders.py.
REMINDER_SCHEDULER=true

# --- Reglas generales ---
TIMEZONE=America/Argentina/Buenos_Aires
MAX_OPEN_BOOKINGS=3

# URL pública de la app: la usa el callback de Google.
# En Render: https://tu-servicio.onrender.com
BASE_URL=http://localhost:8000
